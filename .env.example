EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Existing EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY remains a supported fallback.
EXPO_PUBLIC_MAPTILER_KEY=
# Optional raster templates and attribution:
EXPO_PUBLIC_PLOTBY_TILE_URL=
EXPO_PUBLIC_PLOTBY_NEON_TILE_URL=
EXPO_PUBLIC_PLOTBY_NEON_ATTRIBUTION=

# Optional override for an EXISTING custom owner column. Defaults to user_id after the reviewed migration.
EXPO_PUBLIC_PROPERTY_OWNER_COLUMN=

# Required for standalone Android map builds; restrict this public key to your app.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Optional Help & Support contact details
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
