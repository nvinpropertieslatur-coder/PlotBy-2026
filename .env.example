# Public mobile key restricted to this app's bundle/package and allowed tile origins.
EXPO_PUBLIC_MAPTILER_KEY=replace-with-restricted-maptiler-key
# Optional provider-specific template. Do not point this at public OSM tiles.
# EXPO_PUBLIC_PLOTBY_TILE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=replace-with-restricted-maptiler-key
# Optional custom rasterized Neon Night style (HTTPS XYZ image tiles, not style.json).
# EXPO_PUBLIC_PLOTBY_NEON_TILE_URL=https://tiles.example.com/neon/{z}/{x}/{y}.png?key=your-public-client-key
# EXPO_PUBLIC_PLOTBY_NEON_ATTRIBUTION=© Tile provider © OpenStreetMap contributors

# Supabase public client configuration. Never use a service-role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy projects may use this public key instead of EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Development-only, local unverified mobile preview. Ignored in production builds.
EXPO_PUBLIC_ENABLE_AUTH_PREVIEW=false
# Explicit local sample listing source. Keep false when testing Supabase listings.
EXPO_PUBLIC_USE_SAMPLE_PLOTS=false
# Maximum number of images accepted by the Add Plot picker (10 by default).
EXPO_PUBLIC_PLOT_IMAGE_LIMIT=10
