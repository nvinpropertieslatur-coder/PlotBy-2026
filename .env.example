EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Existing EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY remains a supported fallback.
EXPO_PUBLIC_MAPTILER_KEY=
# Optional raster templates and attribution:
EXPO_PUBLIC_PLOTBY_TILE_URL=
EXPO_PUBLIC_PLOTBY_NEON_TILE_URL=
EXPO_PUBLIC_PLOTBY_NEON_ATTRIBUTION=

# Optional override for an EXISTING custom owner column. Defaults to user_id after the reviewed migration.
EXPO_PUBLIC_PROPERTY_OWNER_COLUMN=

# Required for standalone Android map builds; restrict this public key to your app.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# =====================================================
# META WHATSAPP CLOUD API (BACKEND ONLY - NEVER EXPOSE IN FRONTEND)
# =====================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=plotby_auth_otp
WHATSAPP_TEMPLATE_LANG=en_US

# Backend Server Configuration
PORT=3001
HOST=0.0.0.0
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Frontend Backend API endpoint (defaults to http://192.168.29.205:3001 for physical Android device over Wi-Fi)
EXPO_PUBLIC_API_URL=http://192.168.29.205:3001
